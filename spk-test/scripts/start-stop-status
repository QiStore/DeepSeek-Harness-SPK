#!/bin/sh
set -eu
umask 077

target="${SYNOPKG_PKGDEST:-/var/packages/DeepSeek-Harness-SPK/target}"
state="$target/.test-state"
node="$target/runtime/node"
compat="$target/runtime/compat-lib"
entry="$target/runtime/node_modules/@deepseek-ai/dsh/lib/bin.js"
pidfile="$state/service.pid"
log="$state/startup.log"

running() {
    [ -s "$pidfile" ] || return 1
    pid="$(cat "$pidfile")"
    case "$pid" in ''|*[!0-9]*|0|1) return 1;; esac
    [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = "$(readlink -f "$node")" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
start)
    if [ "$(id -u)" -eq 0 ]; then
        echo "需要 DSM 套件用户运行" >&2
        exit 1
    fi
    if running; then exit 0; fi
    mkdir -p "$state/home" "$state/workspace"
    chmod 700 "$state" "$state/home" "$state/workspace"
    export HOME="$state/home"
    export XDG_CONFIG_HOME="$HOME/config" XDG_DATA_HOME="$HOME/data"
    export XDG_CACHE_HOME="$HOME/cache" XDG_STATE_HOME="$HOME/state"
    cd "$state/workspace"
    LD_LIBRARY_PATH="$compat" "$node" --version > "$log" 2>&1 || exit 1
    if ! host="$(LD_LIBRARY_PATH="$compat" "$node" -e '
        const { networkInterfaces } = require("node:os");
        const addresses = Object.values(networkInterfaces()).flat();
        const lan = addresses.find(({ address, internal }) =>
            !internal && /^192[.]168[.]1[.][0-9]+$/.test(address));
        if (lan) process.stdout.write(lan.address);
    ' 2>> "$log")" || [ -z "$host" ]; then
        echo "没有找到 192.168.1.x 局域网地址" >> "$log"
        exit 1
    fi
    url="http://$host:3080/"
    LD_LIBRARY_PATH="$compat" "$node" "$entry" web --host "$host" --port 3080 --public-url "$url" --trusted-host "$host" --no-open >> "$log" 2>&1 </dev/null &
    pid="$!"
    printf '%s\n' "$pid" > "$pidfile"
    attempts=0
    while kill -0 "$pid" 2>/dev/null && [ "$attempts" -lt 30 ]; do
        if running && grep -Fq "$url" "$log"; then exit 0; fi
        sleep 1
        attempts=$((attempts + 1))
    done
    if running; then kill "$pid" 2>/dev/null || true; fi
    rm -f "$pidfile"
    echo "DeepSeek Harness Web 服务启动失败。请检查套件的私有启动日志。" >&2
    exit 1
    ;;
stop)
    if running; then
        kill "$pid" 2>/dev/null || true
        attempts=0
        while running && [ "$attempts" -lt 15 ]; do
            sleep 1
            attempts=$((attempts + 1))
        done
        if running; then
            echo "服务尚未退出" >&2
            exit 1
        fi
    fi
    rm -f "$pidfile"
    ;;
status)
    if running; then exit 0; fi
    exit 3
    ;;
*) exit 1 ;;
esac
